#!/bin/bash
# wifishare: share the Wi-Fi you're connected to through a hotspot on a
# virtual interface (ap0), like Windows Mobile Hotspot.
#
#   wifishare on | off | toggle
#   wifishare status [--json]
#   wifishare config [--json]
#   wifishare set ssid|password|band|move-wifi <value>
#                                band: auto, 2.4 or 5; move-wifi: yes or no
#   wifishare clients [--json]   connected devices: name, IP, MAC, signal
#   wifishare qr                 print the path to a Wi-Fi QR code PNG
#   wifishare update [--check]   git pull the repo and reinstall what changed
#   wifishare doctor             check whether this laptop can run the hotspot
#   wifishare version
set -uo pipefail

AP=ap0
RUN=/run/wifishare
HELPER=/usr/local/libexec/wifishare-helper
CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/wifishare"
CONF="$CONF_DIR/config"
STATE="${XDG_RUNTIME_DIR:-/tmp}/wifishare"
# This script is a symlink into the repo checkout.
REPO=$(dirname "$(dirname "$(readlink -f "$0")")")

die() { echo "wifishare: $*" >&2; exit 1; }

# --- config --------------------------------------------------------------

SSID=""
PASSWORD=""
BAND=auto   # auto (same as the Wi-Fi connection), 2.4 or 5
MOVE_WIFI=yes   # may move the Wi-Fi connection to another band when needed

load_config() {
    if [[ ! -f $CONF ]]; then
        SSID="${USER^} Hotspot"
        PASSWORD=$(LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 12)
        save_config
        return
    fi
    local line
    while IFS= read -r line || [[ -n $line ]]; do
        case "${line%%=*}" in
            ssid) SSID="${line#*=}" ;;
            password) PASSWORD="${line#*=}" ;;
            band) valid_band "${line#*=}" && BAND="${line#*=}" ;;
            move_wifi) valid_yesno "${line#*=}" && MOVE_WIFI="${line#*=}" ;;
        esac
    done < "$CONF"
}

save_config() {
    mkdir -p "$CONF_DIR"
    (umask 077; printf 'ssid=%s\npassword=%s\nband=%s\nmove_wifi=%s\n' \
        "$SSID" "$PASSWORD" "$BAND" "$MOVE_WIFI" > "$CONF")
}

valid_ssid() { local n; n=$(printf '%s' "$1" | wc -c); (( n >= 1 && n <= 32 )) && [[ $1 != *$'\n'* ]]; }
valid_password() { [[ $1 =~ ^[[:print:]]{8,63}$ ]]; }
valid_band() { [[ $1 == auto || $1 == 2.4 || $1 == 5 ]]; }
valid_yesno() { [[ $1 == yes || $1 == no ]]; }

band_name() { if (( $1 < 3000 )); then echo 2.4; else echo 5; fi; }

json_str() {
    local s=$1
    s=${s//\\/\\\\}
    s=${s//\"/\\\"}
    printf '"%s"' "$s"
}

# --- state ---------------------------------------------------------------

# The Wi-Fi interface we share from: the connected one if any, else the first.
parent_iface() {
    local dev type state first=""
    while IFS=: read -r dev type state; do
        [[ $type == wifi && $dev != "$AP" ]] || continue
        [[ -z $first ]] && first=$dev
        if [[ $state == connected ]]; then echo "$dev"; return; fi
    done < <(nmcli -t -f DEVICE,TYPE,STATE device)
    [[ -n $first ]] && echo "$first"
}

# On when ap0 exists and hostapd (run by the helper as root) is alive.
is_active() {
    local pid
    [[ -e /sys/class/net/$AP && -r $RUN/hostapd.pid ]] || return 1
    pid=$(< "$RUN/hostapd.pid")
    [[ -n $pid && -d /proc/$pid ]]
}

# First channel in a band (2.4 or 5) without no-IR, radar or disabled flags.
# Prints "channel freq".
free_channel() {
    local lo=2400 hi=2500
    [[ $2 == 5 ]] && lo=5150 hi=5900
    iw phy "$1" channels 2>/dev/null | awk -v lo="$lo" -v hi="$hi" '
        function flush() { if (ok) { print ch, f; ok = 0; exit } }
        /\* [0-9]+ MHz \[/ {
            flush()
            f = $2; ch = $4; gsub(/[][]/, "", ch)
            ok = (f >= lo && f <= hi && $0 !~ /disabled/)
            next
        }
        /No IR|Radar detection/ { ok = 0 }
        END { flush() }'
}

# The card's interface combinations, one per line.
iface_combos() {
    iw phy "$1" info 2>/dev/null | awk '
        /valid interface combinations:/ { sec = 1; next }
        sec && !/^\t\t/ { sec = 0 }
        sec && /\* #\{/ { if (c) print c; c = $0; next }
        sec { c = c " " $0 }
        END { if (c) print c }'
}

# How many channels the card can use while it is both a Wi-Fi client and a
# hotspot: 0 = can't do both at once, 1 = hotspot must share the Wi-Fi
# connection's channel (most Intel cards), 2+ = hotspot can use any channel.
ap_channels() {
    iface_combos "$1" | awk '
        /managed/ && /[{ ,]AP[,} ]/ {
            n = 1
            if (match($0, /#channels <= [0-9]+/)) n = substr($0, RSTART + 13, RLENGTH - 13) + 0
            if (n > max) max = n
        }
        END { print max + 0 }'
}

# Why a channel can't host a hotspot, or nothing if it can: dfs or disabled
# (never works), or noir ("No IR": may still work next to a Wi-Fi connection
# on some cards, so hostapd gets to try).
channel_problem() {
    local flags
    flags=$(iw phy "$1" channels 2>/dev/null | grep -A4 "MHz \[$2\]" | head -5)
    if grep -q 'Radar detection' <<< "$flags"; then
        echo dfs
    elif grep -q disabled <<< "$flags"; then
        echo disabled
    elif grep -q 'No IR' <<< "$flags"; then
        echo noir
    fi
}

wifi_ssid() { iw dev "$1" info 2>/dev/null | sed -n 's/^\tssid //p'; }

# Is the network we're connected to also visible on band bg (2.4) or a (5)?
ssid_on_band() {
    local ssid
    ssid=$(wifi_ssid "$1")
    [[ -n $ssid ]] || return 1
    # A fresh scan: the cached list often only has the band we're on.
    nmcli -t -f SSID,FREQ device wifi list ifname "$1" --rescan yes 2>/dev/null \
        | awk -F: -v s="$ssid" -v b="$2" '
            { sub(/\\:/, ":", $1) }
            $1 == s { f = $NF + 0; if ((b == "bg" && f < 3000) || (b == "a" && f > 5000 && f < 5900)) found = 1 }
            END { exit !found }'
}

# Reconnect the Wi-Fi on band bg or a, remembering the old setting so
# restore_wifi can undo it when sharing stops.
move_wifi() {
    local parent=$1 band=$2 uuid old
    uuid=$(nmcli -g GENERAL.CON-UUID device show "$parent" 2>/dev/null)
    [[ -n $uuid ]] || return 1
    old=$(nmcli -g 802-11-wireless.band connection show "$uuid" 2>/dev/null)
    mkdir -p "$STATE"
    printf '%s %s\n' "$uuid" "$old" > "$STATE/moved-wifi"
    if ! nmcli connection modify "$uuid" 802-11-wireless.band "$band" \
        || ! nmcli --wait 30 connection up "$uuid" ifname "$parent" >/dev/null 2>&1; then
        restore_wifi
        nmcli --wait 30 connection up "$uuid" ifname "$parent" >/dev/null 2>&1
        return 1
    fi
    sleep 1   # let the new channel settle before reading it
}

# Undo move_wifi. With a band (bg/a), reconnect there first; otherwise only
# lift the band lock, so the connection moves back on its next roam instead
# of dropping now.
restore_wifi() {
    local uuid old
    [[ -f $STATE/moved-wifi ]] || return 0
    read -r uuid old < "$STATE/moved-wifi"
    if [[ -n ${1:-} ]]; then
        nmcli connection modify "$uuid" 802-11-wireless.band "$1" 2>/dev/null
        nmcli --wait 30 connection up "$uuid" >/dev/null 2>&1
    fi
    nmcli connection modify "$uuid" 802-11-wireless.band "$old" 2>/dev/null
    rm -f "$STATE/moved-wifi"
}

# Connected devices as a JSON array: stations from hostapd joined with
# dnsmasq's DHCP leases (for the IP and the name the device sent).
clients_json() {
    [[ -e /sys/class/net/$AP ]] || { echo '[]'; return; }
    iw dev "$AP" station dump 2>/dev/null | awk -v leases="$RUN/leases" '
        function esc(v) { gsub(/\\/, "\\\\", v); gsub(/"/, "\\\"", v); return v }
        function out() {
            s = s (n++ ? "," : "") sprintf("{\"mac\":\"%s\",\"ip\":\"%s\",\"name\":\"%s\",\"signal\":%s,\"connected\":%s,\"rx\":%s,\"tx\":%s}",
                mac, ip[mac], esc(nm[mac]), sig == "" ? "null" : sig, t == "" ? 0 : t, rx == "" ? 0 : rx, tx == "" ? 0 : tx)
        }
        BEGIN {
            while ((getline l < leases) > 0) {
                split(l, a, " ")
                ip[a[2]] = a[3]
                nm[a[2]] = a[4] == "*" ? "" : a[4]
            }
        }
        /^Station/ { if (mac) out(); mac = $2; sig = t = rx = tx = "" }
        /^\tsignal:/ { sig = $2 }
        /^\tconnected time:/ { t = $3 }
        /^\trx bytes:/ { rx = $3 }
        /^\ttx bytes:/ { tx = $3 }
        END { if (mac) out(); print "[" s "]" }'
}

client_count() {
    [[ -e /sys/class/net/$AP ]] || { echo 0; return; }
    iw dev "$AP" station dump 2>/dev/null | grep -c '^Station' || true
}

# --- on / off ------------------------------------------------------------

# Start the AP through the root helper. Name and password go over stdin so
# they don't show up in `ps`. Sets ERR on failure.
start_ap() {
    local parent=$1 channel=$2 freq=$3 band=g
    (( freq > 3000 )) && band=a
    ERR=$(printf '%s\n%s\n' "$SSID" "$PASSWORD" \
        | pkexec "$HELPER" up "$parent" "$channel" "$band" 2>&1)
}

# Share on the chosen band; if that band can't be used right now, share on
# the Wi-Fi connection's band instead of failing.
turn_on() {
    load_config
    if [[ $BAND != auto ]]; then
        local out
        if out=$(start_sharing 2>&1); then
            echo "$out"
            return
        fi
        echo "Note: couldn't share on $BAND GHz right now, so it's sharing on your Wi-Fi's band instead."
        BAND=auto
    fi
    start_sharing
}

start_sharing() {
    valid_ssid "$SSID" || die "network name must be 1-32 bytes"
    valid_password "$PASSWORD" || die "password must be 8-63 printable characters"

    local parent phy freq channel want maxch problem ssid
    parent=$(parent_iface)
    [[ -n $parent ]] || die "no Wi-Fi adapter found"
    phy=$(iw dev "$parent" info | awk '/wiphy/ {print "phy" $2}')
    iw phy "$phy" info | grep -A12 'Supported interface modes' | grep -q '\* AP$' \
        || die "this Wi-Fi card can't run a hotspot (no access-point mode in its driver)"
    want=$BAND

    read -r channel freq < <(iw dev "$parent" info | awk '/channel/ {print $2, substr($3, 2)}')

    # Not on Wi-Fi (e.g. Ethernet): the radio is free, pick any good channel.
    if [[ -z ${channel:-} ]]; then
        [[ $want == auto ]] && want=2.4
        read -r channel freq < <(free_channel "$phy" "$want")
        [[ -n ${channel:-} ]] || die "no $want GHz channel here allows a hotspot"
        start_ap "$parent" "$channel" "$freq" || die "the hotspot didn't start: $(tail -n 3 <<< "$ERR" | tr '\n' ' ')"
        echo "Sharing as \"$SSID\" on $(band_name "$freq") GHz, channel $channel"
        return
    fi

    maxch=$(ap_channels "$phy")
    (( maxch > 0 )) || die "this Wi-Fi card can't run a hotspot while connected to Wi-Fi. Connect with Ethernet and try again"
    ssid=$(wifi_ssid "$parent")
    [[ $want == auto ]] && want=$(band_name "$freq")
    (( freq >= 5900 )) && problem=6ghz || problem=$(channel_problem "$phy" "$channel")

    # 1. The Wi-Fi connection's own channel, when it may be usable and the
    #    band is the one we want.
    if [[ ( -z $problem || $problem == noir ) && $want == "$(band_name "$freq")" ]] \
        && start_ap "$parent" "$channel" "$freq"; then
        echo "Sharing $ssid as \"$SSID\" on $want GHz, channel $channel"
        return
    fi

    # 2. Cards that can use two channels at once: any free channel.
    local ch2 f2
    if (( maxch >= 2 )); then
        read -r ch2 f2 < <(free_channel "$phy" "$want")
        if [[ -n ${ch2:-} ]] && start_ap "$parent" "$ch2" "$f2"; then
            echo "Sharing $ssid as \"$SSID\" on $want GHz, channel $ch2"
            return
        fi
    fi

    # 3. Move the Wi-Fi connection to the same network on another band (if
    #    the router has one), then share on its new channel. That band is the
    #    one you picked, or 2.4 GHz when the current 5 GHz channel can't host.
    local cur target=""
    cur=$(band_name "$freq")
    if [[ $want != "$cur" ]]; then
        target=$want
    elif [[ $cur == 5 ]]; then
        target=2.4
    fi
    if [[ $MOVE_WIFI == yes && -n $target ]]; then
        local nmband=bg curband=bg
        [[ $target == 5 ]] && nmband=a
        [[ $cur == 5 ]] && curband=a
        if ssid_on_band "$parent" "$nmband" && move_wifi "$parent" "$nmband"; then
            read -r ch2 f2 < <(iw dev "$parent" info | awk '/channel/ {print $2, substr($3, 2)}')
            if [[ -n ${ch2:-} && $(channel_problem "$phy" "$ch2") != @(dfs|disabled) ]] \
                && start_ap "$parent" "$ch2" "$f2"; then
                echo "Note: moved your Wi-Fi ($ssid) to $target GHz so it can share; it's released when you turn sharing off."
                echo "Sharing $ssid as \"$SSID\" on $target GHz, channel $ch2"
                return
            fi
            # Didn't help: put the Wi-Fi back where it was.
            restore_wifi "$curband"
            die "moved your Wi-Fi ($ssid) to $target GHz, but this card won't start a hotspot on its channel there (${ch2:-?}), so it's back on $cur GHz. Set the band to Same as Wi-Fi to share on $cur GHz"
        fi
    fi

    # Nothing worked: explain what to change.
    case $problem in
    dfs) die "your Wi-Fi ($ssid) is on 5 GHz channel $channel, a radar-protected (DFS) channel where laptops can't start a hotspot, and this card can only host on the channel it's connected to. Connect to a 2.4 GHz network, set your router's 5 GHz channel to 36-48 or 149-165, or use Ethernet" ;;
    6ghz) die "your Wi-Fi ($ssid) is on 6 GHz, where laptops can't start a hotspot. Connect on 2.4 or 5 GHz, or use Ethernet" ;;
    disabled) die "channel $channel isn't allowed for a hotspot here. Connect on another band or use Ethernet" ;;
    noir) die "your Wi-Fi card won't start a hotspot on channel $channel ($(band_name "$freq") GHz) right now, and $ssid isn't available on 2.4 GHz here. Connect to a 2.4 GHz network or use Ethernet" ;;
    esac
    if [[ $want != "$(band_name "$freq")" ]]; then
        die "your Wi-Fi is on $(band_name "$freq") GHz and this card can only host on the same channel. Set the band to Auto, or connect to a $want GHz network or Ethernet"
    fi
    die "the hotspot didn't start: $(tail -n 3 <<< "${ERR:-}" | tr '\n' ' ')"
}

turn_off() {
    if [[ -e /sys/class/net/$AP || -d $RUN ]]; then
        pkexec "$HELPER" down || die "could not remove the hotspot interface"
    fi
    restore_wifi
    echo "Hotspot off"
}

# --- commands ------------------------------------------------------------

cmd=${1:-status}
case "$cmd" in
on) turn_on ;;
off) turn_off ;;
toggle) if is_active; then turn_off; else turn_on; fi ;;
status)
    load_config
    active=false; is_active && active=true
    clients=$(client_count)
    channel="" freq="" ghz=""
    [[ $active == true ]] && read -r channel freq < <(iw dev "$AP" info 2>/dev/null | awk '/channel/ {print $2, substr($3, 2)}')
    [[ -n $freq ]] && ghz=$(band_name "$freq")
    address=$(ip -4 -o addr show "$AP" 2>/dev/null | awk '{sub("/.*", "", $4); print $4; exit}')
    # Where the internet comes from: the interface of the default route.
    src_dev=$(ip route get 1.1.1.1 2>/dev/null | awk '{for (i = 1; i < NF; i++) if ($i == "dev") { print $(i + 1); exit }}')
    src_name=""
    [[ -n $src_dev ]] && src_name=$(nmcli -g GENERAL.CONNECTION device show "$src_dev" 2>/dev/null)
    if [[ ${2:-} == --json ]]; then
        printf '{"active":%s,"ssid":%s,"password":%s,"band":%s,"clients":%d,"channel":%s,"ghz":%s,"source":%s,"source_dev":%s,"address":%s,"move_wifi":%s,"devices":%s}\n' \
            "$active" "$(json_str "$SSID")" "$(json_str "$PASSWORD")" "$(json_str "$BAND")" \
            "$clients" "${channel:-null}" "$(if [[ -n $ghz ]]; then json_str "$ghz"; else echo null; fi)" \
            "$(json_str "$src_name")" "$(json_str "$src_dev")" "$(json_str "$address")" \
            "$( [[ $MOVE_WIFI == yes ]] && echo true || echo false)" "$(clients_json)"
    else
        if [[ $active == true ]]; then
            echo "On: \"$SSID\" on $ghz GHz, channel $channel, $clients device(s) connected"
        else
            echo "Off"
        fi
        echo "Password: $PASSWORD"
        echo "Band: $BAND"
    fi
    ;;
clients)
    if [[ ${2:-} == --json ]]; then
        clients_json
    else
        clients_json | python3 -c '
import json, sys
devs = json.load(sys.stdin)
if not devs:
    print("No devices connected")
for d in devs:
    m, s = divmod(d["connected"], 60)
    name, ip = d["name"] or "(no name)", d["ip"] or "-"
    print(f"{name:20} {ip:16} {d["mac"]}  {d["signal"]} dBm  {m}m{s:02d}s  down {d["tx"]/1e6:.1f} MB  up {d["rx"]/1e6:.1f} MB")
'
    fi
    ;;
config)
    load_config
    if [[ ${2:-} == --json ]]; then
        printf '{"ssid":%s,"password":%s,"band":%s,"move_wifi":%s}\n' \
            "$(json_str "$SSID")" "$(json_str "$PASSWORD")" "$(json_str "$BAND")" \
            "$( [[ $MOVE_WIFI == yes ]] && echo true || echo false)"
    else
        printf 'ssid=%s\npassword=%s\nband=%s\nmove_wifi=%s\n' "$SSID" "$PASSWORD" "$BAND" "$MOVE_WIFI"
    fi
    ;;
set)
    load_config
    key=${2:-} value=${3:-}
    case "$key" in
        ssid) valid_ssid "$value" || die "network name must be 1-32 bytes"; SSID=$value ;;
        password) valid_password "$value" || die "password must be 8-63 printable characters"; PASSWORD=$value ;;
        band) valid_band "$value" || die "band must be auto, 2.4 or 5"; BAND=$value ;;
        move-wifi) valid_yesno "$value" || die "move-wifi must be yes or no"; MOVE_WIFI=$value ;;
        *) die "usage: wifishare set ssid|password|band|move-wifi <value>" ;;
    esac
    save_config
    # Apply right away if the hotspot is running. If the new band can't be
    # used right now, keep sharing on the Wi-Fi's band and keep the choice
    # for next time.
    if is_active; then
        turn_off >/dev/null
        turn_on
    fi
    ;;
qr)
    command -v qrencode >/dev/null || die "qrencode is not installed"
    load_config
    esc() { local s=$1; s=${s//\\/\\\\}; s=${s//;/\\;}; s=${s//,/\\,}; s=${s//:/\\:}; s=${s//\"/\\\"}; printf '%s' "$s"; }
    payload="WIFI:T:WPA;S:$(esc "$SSID");P:$(esc "$PASSWORD");;"
    dir="${XDG_RUNTIME_DIR:-/tmp}/wifishare"
    mkdir -p "$dir"
    file="$dir/qr-$(printf '%s' "s12$payload" | sha1sum | cut -c1-12).png"
    if [[ ! -f $file ]]; then
        rm -f "$dir"/qr-*.png
        qrencode -o "$file" -s 12 -m 2 -l M "$payload" || die "could not make the QR code"
    fi
    echo "$file"
    ;;
doctor)
    # Checks whether this laptop can run the hotspot, and why not if it can't.
    fails=0
    g="" y="" r="" n=""
    [[ -t 1 ]] && g=$'\e[32m' y=$'\e[33m' r=$'\e[31m' n=$'\e[0m'
    ok() { printf '  %s✓%s %s\n' "$g" "$n" "$*"; }
    warn() { printf '  %s!%s %s\n' "$y" "$n" "$*"; }
    bad() { printf '  %s✗%s %s\n' "$r" "$n" "$*"; fails=$((fails + 1)); }

    echo "Wi-Fi card"
    parent=$(parent_iface)
    if [[ -z $parent ]]; then
        bad "no Wi-Fi adapter found"
    else
        phy=$(iw dev "$parent" info | awk '/wiphy/ {print "phy" $2}')
        driver=$(basename "$(readlink -f "/sys/class/net/$parent/device/driver")" 2>/dev/null)
        ok "$parent (driver ${driver:-unknown})"
        if iw phy "$phy" info | grep -A12 'Supported interface modes' | grep -q '\* AP$'; then
            ok "supports hotspot (AP) mode"
        else
            bad "driver has no hotspot (AP) mode; this card can't share at all"
        fi
        case $(ap_channels "$phy") in
            0) bad "can't be a hotspot while connected to Wi-Fi; share only from Ethernet" ;;
            1) ok "hotspot alongside Wi-Fi, on the same channel as the connection" ;;
            *) ok "hotspot alongside Wi-Fi, on any channel" ;;
        esac

        echo "Current connection"
        read -r channel freq < <(iw dev "$parent" info | awk '/channel/ {print $2, substr($3, 2)}')
        if [[ -z ${channel:-} ]]; then
            ok "Wi-Fi not connected; the hotspot can use any free channel"
        else
            net=$(wifi_ssid "$parent")
            problem=$(channel_problem "$phy" "$channel")
            (( freq >= 5900 )) && problem=6ghz
            if [[ -z $problem ]]; then
                ok "$net on $(band_name "$freq") GHz, channel $channel: can host"
            elif [[ $problem == noir ]] && ssid_on_band "$parent" bg; then
                warn "$net is on channel $channel, marked No-IR: if the card refuses to host there, sharing moves your Wi-Fi to $net's 2.4 GHz band"
            elif [[ $problem == noir ]]; then
                warn "$net is on channel $channel, marked No-IR: the card may refuse to host there, and $net isn't visible on 2.4 GHz"
            elif (( $(ap_channels "$phy") >= 2 )); then
                ok "$net is on channel $channel (${problem^^}); the hotspot will use another channel"
            elif ssid_on_band "$parent" bg; then
                warn "$net is on channel $channel (${problem^^}), which can't host; sharing will move your Wi-Fi to $net's 2.4 GHz band"
            else
                bad "$net is on channel $channel (${problem^^}), which can't host, and isn't visible on 2.4 GHz. Use 2.4 GHz, set the router's 5 GHz to channel 36-48 or 149-165, or use Ethernet"
            fi
        fi
    fi

    echo "Installed parts"
    if command -v wifishare >/dev/null; then
        ok "wifishare command on PATH"
    else
        warn "wifishare command isn't on PATH (run install.sh, then open a new terminal)"
    fi
    for t in hostapd dnsmasq iw nft pkexec qrencode; do
        if command -v "$t" >/dev/null || [[ -x /usr/sbin/$t ]]; then ok "$t"; else bad "$t is missing (run install.sh)"; fi
    done
    if [[ -x $HELPER ]]; then
        if cmp -s "$REPO/helper/wifishare-helper" "$HELPER"; then ok "root helper up to date"; else warn "root helper is out of date (run install.sh)"; fi
    else
        bad "root helper not installed (run install.sh)"
    fi
    [[ -f /usr/share/polkit-1/actions/io.github.kumarsujay03.wifishare.policy ]] && ok "polkit rule" || bad "polkit rule missing (run install.sh)"
    [[ -f /etc/NetworkManager/conf.d/90-wifishare.conf ]] && ok "NetworkManager leaves ap0 alone" || bad "NetworkManager config missing (run install.sh)"
    if gnome-extensions info wifishare@kumarsujay03.github.io 2>/dev/null | grep -q 'Enabled: Yes'; then
        ok "Quick Settings extension enabled"
    else
        warn "Quick Settings extension not enabled (log out and in, then: gnome-extensions enable wifishare@kumarsujay03.github.io)"
    fi

    echo "Firewall"
    if systemctl is-active -q firewalld 2>/dev/null; then
        warn "firewalld is on; install.sh puts ap0 in its nm-shared zone"
    elif systemctl is-active -q ufw 2>/dev/null; then
        ok "ufw is on; install.sh adds rules for ap0"
    else
        ok "no firewall to configure"
    fi

    echo
    if (( fails )); then echo "$fails problem(s) found."; exit 1; fi
    echo "Everything looks good."
    ;;
version)
    echo "wifishare $(< "$REPO/VERSION") ($(git -C "$REPO" describe --tags --always --dirty 2>/dev/null || echo unknown))"
    ;;
update)
    git -C "$REPO" rev-parse --git-dir >/dev/null 2>&1 \
        || die "$REPO is not a git checkout; reinstall from a git clone to get updates"
    branch=$(git -C "$REPO" rev-parse --abbrev-ref HEAD)
    git -C "$REPO" fetch --quiet --tags origin "$branch" || die "could not reach GitHub"
    behind=$(git -C "$REPO" rev-list --count "HEAD..origin/$branch")
    if [[ ${2:-} == --check ]]; then
        if (( behind )); then
            echo "Update available: $(git -C "$REPO" show "origin/$branch:VERSION" 2>/dev/null || echo newer) ($behind new commit(s)). Run: wifishare update"
        else
            echo "Up to date ($(< "$REPO/VERSION"))"
        fi
        exit 0
    fi
    if (( ! behind )); then
        echo "Already up to date ($(< "$REPO/VERSION"))"
        exit 0
    fi
    old=$(< "$REPO/VERSION")
    git -C "$REPO" merge --ff-only --quiet "origin/$branch" \
        || die "your checkout has local changes that conflict; commit or stash them first"
    "$REPO/install.sh"
    echo "Updated $old -> $(< "$REPO/VERSION")"
    ;;
-h|--help|help) awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0" ;;
*) die "unknown command: $cmd (try --help)" ;;
esac
