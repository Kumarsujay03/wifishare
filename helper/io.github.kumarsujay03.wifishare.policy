<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <action id="io.github.kumarsujay03.wifishare.helper">
    <description>Create or remove the Wi-Fi sharing hotspot interface</description>
    <message>Authentication is required to change the Wi-Fi hotspot interface</message>
    <icon_name>network-wireless-hotspot-symbolic</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/wifishare-helper</annotate>
  </action>
</policyconfig>
